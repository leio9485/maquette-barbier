# Modele a recopier en .env lors de l'installation d'une nouvelle instance client.
# Celui-ci, contrairement a .env, est versionne dans git : il ne doit donc
# contenir aucun vrai secret.

DATABASE_URL="file:./data/commerce.db"
PORT=3000

# Adresse publique du site, une fois en ligne. Sert a l'en-tete de la page :
# adresse canonique pour les moteurs de recherche, et lien de la fiche dans les
# apercus de partage. Laisser vide en local : ces deux lignes sont alors omises.
# PUBLIC_URL="https://letabli-bavay.fr"

# INDISPENSABLE en production, et seulement la : active le cookie de session
# "Secure" (qui interdit au navigateur de l'envoyer hors d'une liaison chiffree)
# et la prise en compte du relais de l'hebergeur pour les compteurs de tentatives.
# NODE_ENV=production

# La vitrine de demonstration : compte d'acces affiche sur l'ecran de connexion,
# base remise a zero chaque nuit, site retire des moteurs de recherche.
#
# >>> A POSER SUR L'INSTANCE DE DEMONSTRATION UNIQUEMENT (variable de
#     l'hebergeur), JAMAIS chez un vrai client : ce serait publier l'agenda de
#     ses clients avec le mot de passe a cote. <<<
#
# ⚠️ NE PAS L'ACTIVER EN LOCAL POUR LANCER LES TESTS. La suite verifie
#    precisement qu'une instance ordinaire ne porte aucune trace du mode
#    demonstration : identifiants publies, remise a zero accessible, site retire
#    des moteurs. Avec DEMO_MODE=true, ces controles echouent — et ils ont
#    raison de le faire.
# DEMO_MODE=true
