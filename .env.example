# Modele a recopier en .env lors de l'installation d'une nouvelle instance client.
# Celui-ci, contrairement a .env, est versionne dans git : il ne doit donc
# contenir aucun vrai secret.

DATABASE_URL="file:./data/commerce.db"
PORT=3000

# Adresse publique du site, une fois en ligne. Sert a l'en-tete de la page :
# adresse canonique pour les moteurs de recherche, et lien de la fiche dans les
# apercus de partage. Laisser vide en local : ces deux lignes sont alors omises.
# PUBLIC_URL="https://letabli-bavay.fr"

# INDISPENSABLE en production, et seulement la : active le cookie de session
# "Secure" (qui interdit au navigateur de l'envoyer hors d'une liaison chiffree)
# et la prise en compte du relais de l'hebergeur pour les compteurs de tentatives.
# NODE_ENV=production

# La vitrine de demonstration : compte d'acces affiche sur l'ecran de connexion,
# base remise a zero chaque nuit, site retire des moteurs de recherche.
#
# >>> A POSER SUR L'INSTANCE DE DEMONSTRATION UNIQUEMENT (variable de
#     l'hebergeur), JAMAIS chez un vrai client : ce serait publier l'agenda de
#     ses clients avec le mot de passe a cote. <<<
#
# ⚠️ NE PAS L'ACTIVER EN LOCAL POUR LANCER LES TESTS. La suite verifie
#    precisement qu'une instance ordinaire ne porte aucune trace du mode
#    demonstration : identifiants publies, remise a zero accessible, site retire
#    des moteurs. Avec DEMO_MODE=true, ces controles echouent — et ils ont
#    raison de le faire.
# DEMO_MODE=true

# --- LES SMS ---------------------------------------------------------------
#
# ECRITS, TESTES, ET VOLONTAIREMENT ETEINTS. Le code d'envoi est complet (il
# appelle l'API de Twilio), mais il ne s'allume que si SMS_ACTIF vaut exactement
# "true" ET que les trois identifiants sont poses. Ne les poser que chez un
# client qui a achete l'option.
#
# SMS_ACTIF=true
# SMS_COMPTE=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   (Twilio : Account SID)
# SMS_JETON=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      (Twilio : Auth Token)
# SMS_EXPEDITEUR=+33xxxxxxxxx
#
# Plafond mensuel DUR. Au-dela, l'envoi est refuse, compte a part et affiche au
# commercant — jamais depasse en silence. 200 par defaut.
# SMS_PLAFOND_MOIS=200

# --- LES PLAFONDS DE RESERVATION -------------------------------------------
#
# Rien n'empechait de remplir l'agenda d'un client avec une boucle de dix
# lignes : aucun acompte, aucun compte a creer. Ces plafonds transforment une
# catastrophe en desagrement. Ils n'arretent PAS un adversaire avec plusieurs
# adresses — la vraie parade contre celui-la est refusee par le produit.
#
# Cales pour ne JAMAIS gener un client reel, y compris derriere une adresse
# partagee (reseau mobile d'un operateur, wifi d'entreprise). Les valeurs par
# defaut conviennent a un commerce de quartier ; ne les changer qu'en
# connaissance de cause.
#
# RESERVATIONS_RAFALE_MAX=5        reservations abouties par 3 minutes
# RESERVATIONS_HEURE_MAX=20        reservations abouties par heure
# RESERVATIONS_TENTATIVES_MAX=60   tentatives, abouties ou non, par heure
#
# ⚠️ Ils ne s'appliquent PAS a la machine elle-meme hors production : `npm test`
#    envoie quarante-trois demandes en quinze secondes, ce qui est exactement le
#    profil qu'ils arretent. En production (`NODE_ENV=production`) l'exemption
#    n'existe pas, pour personne.

# ---------------------------------------------------------------------------
# L'HEBERGEUR, TEL QU'IL FIGURE DANS LES MENTIONS LEGALES
#
# Le paragraphe « Hébergement » de /mentions-legales est construit a partir de
# ces trois lignes. Absentes, la page affiche une mention neutre
# (« Hébergement : voir la configuration du déploiement ») : c'est voulu, et
# c'est preferable a la phrase ecrite en dur qu'elles remplacent — celle-ci
# nommait un hebergeur qui n'etait pas celui qui servait la page.
#
# A RENSEIGNER CHEZ CHAQUE CLIENT, avec l'hebergeur reellement retenu.
# HEBERGEUR_NOM="Render, Inc."
# HEBERGEUR_PAYS="Allemagne, Francfort"
# HEBERGEUR_URL="https://render.com"

# >>> N'AFFIRMEZ CECI QU'EN CONNAISSANCE DE CAUSE. <<< A "true", la page ecrit
# « aucune donnée n'est transférée hors de l'Union européenne ». C'est une
# declaration RGPD : elle ne se deduit pas du pays de l'hebergeur. Un hebergeur
# allemand derriere un relais mondial (Cloudflare, par exemple) ne permet pas de
# l'ecrire — c'est le cas de l'instance de demonstration, ou cette ligne reste
# donc absente.
# HEBERGEUR_UE=true

# ---------------------------------------------------------------------------
# LES PLAFONDS (facultatifs — les valeurs par defaut conviennent)
#
# RESERVATIONS_MINUTE_MAX : les TENTATIVES de reservation par minute et par
# adresse, abouties ou non. Trente par defaut. C'est lui qui arrete une rafale
# de requetes invalides ; les autres plafonds sont horaires, ou ne comptent que
# ce qui aboutit.
# RESERVATIONS_MINUTE_MAX=30
#
# ADMIN_ECRITURES_MAX : les ecritures de l'espace commercant par minute et par
# adresse (POST, PUT, PATCH, DELETE). Cent vingt par defaut. Les LECTURES ne
# sont pas comptees. Ne pas serrer : un plafond qui se referme sur le
# commercant ne protege de rien.
# ADMIN_ECRITURES_MAX=120
