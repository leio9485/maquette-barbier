{
  "name": "letabli-barbier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site vitrine et backend pour barbier — base reutilisable, une instance par client",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
