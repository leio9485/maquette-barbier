    "db:studio": "prisma studio",
    "admin:create": "node scripts/create-admin.js",
    "db:backup": "node scripts/backup.js",
    "test:api": "node tests/api.mjs",
    "test:settings": "node tests/settings.mjs",
    "test:auth": "node tests/auth.mjs",
    "test:staff": "node tests/staff.mjs",
    "test:categories": "node tests/categories.mjs",
    "test": "node tests/run.mjs",
    "test:annulation": "node tests/annulation.mjs",
    "test:chiffres": "node tests/chiffres.mjs",
    "test:espace": "node tests/espace.mjs",
    "test:seo": "node tests/seo.mjs",
    "test:portees": "node tests/portees.mjs",
    "test:tunnel": "node tests/tunnel.mjs",
    "test:debit": "node tests/debit.mjs",
    "test:demonstration": "node tests/demonstration.mjs",
    "test:courriels": "node tests/courriels.mjs",
    "test:blocages": "node tests/blocages.mjs",
    "test:deplacement": "node tests/deplacement.mjs",
    "test:comptes": "node tests/comptes.mjs",
    "test:francais": "node tests/francais.mjs",
    "test:erreurs": "node tests/erreurs.mjs",
    "test:legal": "node tests/legal.mjs",
    "test:export": "node tests/export.mjs",
    "test:ics": "node tests/ics.mjs",
    "test:sessions": "node tests/sessions.mjs"
